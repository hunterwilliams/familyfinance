# Postgres
POSTGRES_USER=familyfinance
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=familyfinance

# Auth
JWT_SECRET=change-me-jwt
SKIP_AUTH=false

# LINE Login (web)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=https://your-api.example.com/api/v1/auth/line/callback
WEB_BASE_URL=https://your-web.example.com

# LINE Messaging (bot)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
PUBLIC_BASE_URL=https://your-api.example.com

# OpenAI, OpenRouter (sk-or-...), or xAI (xai-...). Settings UI overrides this when a key is saved.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional OpenAI-compatible proxy
# OPENAI_BASE_URL=https://api.openai.com/v1

# Web
WEB_PORT=3000
